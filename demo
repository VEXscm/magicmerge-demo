#!/usr/bin/env bash
# Replay every case with stock Git, or with a repo-local MagicMerge driver.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT"

MODE="${1:-}"
if [[ "$MODE" != "without" && "$MODE" != "with" ]]; then
  echo "Usage: $0 without|with" >&2
  exit 2
fi

if [[ ! -d "$ROOT/.git" ]]; then
  echo "Run this from a git clone of magicmerge-demo." >&2
  exit 1
fi

CASES=(
  01-status-last-updated
  02-status-prd-row
  03-status-additive-rows
  04-json-independent-keys
  05-rust-independent-args
  06-ruby-replay-stub
  07-route-coverage
  08-git-view-delete-modify
  09-swarm-owned-functions
  10-divergent-timeout
)

WORKDIR="$(mktemp -d "${TMPDIR:-/tmp}/magicmerge-demo.XXXXXX")"
cleanup() { rm -rf "$WORKDIR"; }
trap cleanup EXIT

git clone --quiet "$ROOT" "$WORKDIR/repo"
cd "$WORKDIR/repo"

if [[ "$MODE" == "with" ]]; then
  if ! command -v com >/dev/null 2>&1; then
    echo "Need the com CLI on PATH, then: com login" >&2
    exit 1
  fi
  com merge-file --install-driver --gitattributes
fi

pass=0
fail=0
printf '\n== %s MagicMerge ==\n\n' "$MODE"

for id in "${CASES[@]}"; do
  path="$(tr -d '\n' < "$ROOT/fixtures/$id/path.txt")"
  expect="$(python3 -c "import json; print(json.load(open('$ROOT/fixtures/$id/meta.json'))['expect_$MODE'])")"
  git switch --quiet "case/$id/ours"
  set +e
  git merge --quiet --no-edit "case/$id/theirs" >/tmp/magicmerge-merge.out 2>&1
  merge_status=$?
  set -e
  unmerged="$(git ls-files -u | wc -l | tr -d ' ')"
  if [[ "$unmerged" != "0" || "$merge_status" -ne 0 ]]; then
    result="conflict"
  else
    result="combine"
  fi
  if [[ "$result" == "$expect" ]]; then
    mark="ok"
    pass=$((pass + 1))
  else
    mark="CHECK"
    fail=$((fail + 1))
  fi
  printf '%s  %-32s expect=%-8s got=%-8s  %s\n' "$mark" "$id" "$expect" "$result" "$path"
  if [[ "$result" == "conflict" ]]; then
    git diff --name-only --diff-filter=U | sed 's/^/    unmerged: /'
  elif [[ -f "$path" ]]; then
    python3 - "$path" <<'PY'
import sys
from pathlib import Path
text = Path(sys.argv[1]).read_text()
for line in text.splitlines()[:8]:
    print("    " + line)
if text.count("\n") > 8:
    print("    …")
PY
  else
    echo "    (file deleted)"
  fi
  git merge --abort >/dev/null 2>&1 || git reset --quiet --hard "case/$id/ours"
done

echo
echo "$pass ok vs the README column for this pass, $fail differed."
echo "Workdir was $WORKDIR"
